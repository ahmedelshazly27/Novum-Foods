# Claude Code cloud environment variables (environment settings -> Edit).
# Never commit real values.

# Supabase
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst        # Project Settings -> General -> Project ID
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx    # supabase.com/dashboard/account/tokens (CLI deploys)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                  # Project Settings -> API keys -> service_role (secret)

# Resend (sends the confirmation email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional
NOTIFY_EMAIL=hello@novum-foods.com                # team inbox alerted on every new lead
